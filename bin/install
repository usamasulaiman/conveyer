#!/usr/bin/env bash
# Install conveyer into $HOME. Idempotent.
#   bin/install [--host laptop|dev] [--dry-run]
#
# - AGENTS.md → ~/.pi/agent/AGENTS.md (symlink); ~/.claude/CLAUDE.md (generated, imports AGENTS.md)
# - skills/*  → ~/.agents/skills, ~/.claude/skills (symlinks)
# - settings  → ~/.claude/settings.json, ~/.pi/agent/settings.json (generated: base ⊕ host overlay)
# - pi extension → ~/.pi/agent/extensions/ (symlink)
# - host env  → ~/.config/conveyer/env (CATAPULT_INGEST_URL etc.)
# - repo hooks → core.hooksPath=.githooks (gitleaks pre-commit)
# A generated file that was edited by hand since the last install is backed up as *.bak.<ts>.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host="" dry=0
while [ $# -gt 0 ]; do
    case "$1" in
        --host) host="$2"; shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) echo "usage: bin/install [--host NAME] [--dry-run]" >&2; exit 2 ;;
    esac
done
if [ -z "$host" ]; then
    case "$(hostname -s)" in rock-*) host=dev ;; *) host=laptop ;; esac
fi
overlay="$DIR/hosts/$host.json"
[ -f "$overlay" ] || { echo "no overlay for host '$host' ($overlay)" >&2; exit 1; }
command -v node >/dev/null || { echo "node is required" >&2; exit 1; }

STATE="$HOME/.local/state/conveyer"
say() { printf '%s\n' "$*"; }
run() { if [ "$dry" -eq 1 ]; then say "  would: $*"; else "$@"; fi; }

link() { # link SRC DEST
    local src="$1" dest="$2"
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then return 0; fi
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        say "  backup $dest"; run mv "$dest" "$dest.bak.$(date +%s)"
    fi
    say "  link $dest"
    run mkdir -p "$(dirname "$dest")"; run ln -sfn "$src" "$dest"
}

# generate DEST  (content on stdin). Backs up hand edits, skips when unchanged.
generate() {
    local dest="$1" tmp key
    tmp="$(mktemp)"; cat > "$tmp"
    key="$STATE/$(printf '%s' "$dest" | tr '/' '_').sha"
    if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then rm -f "$tmp"; return 0; fi
    if [ -f "$dest" ] && [ ! -L "$dest" ]; then
        if [ ! -f "$key" ] || [ "$(shasum "$dest" | cut -d' ' -f1)" != "$(cat "$key")" ]; then
            say "  backup $dest (not generated by conveyer)"; run cp "$dest" "$dest.bak.$(date +%s)"
        fi
    fi
    say "  write $dest"
    if [ "$dry" -eq 0 ]; then
        mkdir -p "$(dirname "$dest")" "$STATE"
        rm -f "$dest"; cp "$tmp" "$dest"
        shasum "$dest" | cut -d' ' -f1 > "$key"
    fi
    rm -f "$tmp"
}

extract() { node -e 'const j=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(JSON.stringify(j[process.argv[2]]??{}))' "$1" "$2"; }
subst() { sed "s|{{CONVEYER_DIR}}|$DIR|g"; }

say "conveyer install (host=$host)"
tmpd="$(mktemp -d)"; trap 'rm -rf "$tmpd"' EXIT

say "instructions"
link "$DIR/AGENTS.md" "$HOME/.pi/agent/AGENTS.md"
subst < "$DIR/claude/CLAUDE.md" | generate "$HOME/.claude/CLAUDE.md"

say "skills"
for s in "$DIR"/skills/*/; do
    n="$(basename "$s")"
    link "${s%/}" "$HOME/.agents/skills/$n"
    link "${s%/}" "$HOME/.claude/skills/$n"
done

say "settings"
extract "$overlay" claude > "$tmpd/claude.overlay.json"
extract "$overlay" pi > "$tmpd/pi.overlay.json"
node "$DIR/bin/merge.mjs" "$DIR/claude/settings.base.json" "$tmpd/claude.overlay.json" | subst | generate "$HOME/.claude/settings.json"
node "$DIR/bin/merge.mjs" "$DIR/pi/settings.base.json" "$tmpd/pi.overlay.json" | subst | generate "$HOME/.pi/agent/settings.json"

say "pi extensions"
for e in "$DIR"/pi/extensions/*.ts; do
    link "$e" "$HOME/.pi/agent/extensions/$(basename "$e")"
done

say "repo hooks"
# Secret scan before each commit to this (public) repo.
if [ "$(git -C "$DIR" config core.hooksPath 2>/dev/null)" != ".githooks" ]; then
    say "  set core.hooksPath"; run git -C "$DIR" config core.hooksPath .githooks
fi

say "host env"
# shellcheck disable=SC2016
node -e 'const e=JSON.parse(process.argv[1]);for(const[k,v]of Object.entries(e))console.log(`${k}=${JSON.stringify(v)}`)' "$(extract "$overlay" env)" \
    | generate "$HOME/.config/conveyer/env"
say "done"
